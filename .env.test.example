# ──────────────────────────────────────────────────────────
#  AI 콘텐츠 스튜디오 — 테스트 인스턴스 환경변수 샘플 (.env.test.example)
#  · 운영 .env 와 분리된 '안전한' 로컬 테스트용: 별도 포트·별도 데이터 루트·가짜 키,
#    자율 사이클·스케줄·자동 발행·알림은 전부 꺼 둔다(외부 계정에 아무것도 올라가지 않음).
#  · 사용법(프로젝트 루트에서):
#      cp .env.test.example .env.test
#      GEPA_ENV_FILE=.env.test pnpm start
#  · 실제 외부 연동을 시험할 때만 해당 키를 진짜 값으로 바꾼다 — .env.test 는 .gitignore 대상.
#  · 전체 변수 설명은 .env.example 참고.
# ──────────────────────────────────────────────────────────

# ── 서버 기본 — 운영(8787/8788)과 겹치지 않게 2씩 벌린 포트 ──
PORT=8797
HOST=127.0.0.1
# 운영 데이터(sessions·wiki·pieces 등)를 건드리지 않도록 별도 데이터 루트
GEPA_DATA_DIR=./data-test
TZ=Asia/Seoul

# ── LLM — 구독(claude CLI) OAuth 사용. API 키로 시험하려면 주석 해제
# ANTHROPIC_API_KEY=sk-ant-test-0000000000000000

# ── 외부 API — 형식만 맞춘 가짜 값(호출 시 인증 실패 → 각 기능은 fail-open/폴백 경로를 탄다)
OPENAI_API_KEY=sk-test-0000000000000000
OPENAI_IMAGE_MODEL=gpt-image-2
NAVER_CLIENT_ID=test-naver-client-id
NAVER_CLIENT_SECRET=test-naver-client-secret
NAVER_SEARCHAD_API_KEY=test-searchad-api-key
NAVER_SEARCHAD_SECRET_KEY=test-searchad-secret
NAVER_SEARCHAD_CUSTOMER_ID=0000000
YOUTUBE_API_KEY=test-youtube-api-key
YOUTUBE_OAUTH_CLIENT_ID=test-client-id.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=test-youtube-oauth-secret
INSTAGRAM_APP_ID=000000000000000
INSTAGRAM_APP_SECRET=test-instagram-app-secret
META_APP_ID=000000000000000
META_APP_SECRET=test-meta-app-secret
FAL_KEY=test-fal-key
ELEVENLABS_API_KEY=test-elevenlabs-key
ELEVENLABS_VOICE_ID=test-voice-id
LAW_API_KEY=test-law-api-key
DART_API_KEY=test-dart-api-key

# ── 네이버 블로그 — 테스트에서는 로그인·발행 안 함(세션 파일도 분리)
NAVER_BLOG_ID=
NAVER_LOGIN_ID=
NAVER_LOGIN_PW=
NAVER_SESSION_FILE=./data-test/.naver_session.json

# ── 비용 보호 — 유료 생성 최소화
SHORTS_I2V=off
SHORTS_I2V_MAX_CLIPS=0
TTS_PROVIDER=openai
BLOG_AUTO_IMAGE=false
MONTHLY_BUDGET_USD=5

# ── 자율 사이클·스케줄 — 전부 off(수동 실행만)
AUTO_CYCLE_MINUTES=0
RESEARCH_CYCLE_HOURS=0
AUTO_SHORTS_PER_DAY=0
AUTO_CARDNEWS_PER_DAY=0
AUTORUN_TIMES=
PERFORMANCE_SYNC_TIME=
DAILY_BRIEFING_TIME=
# 코드 기본이 03:00 이라 명시적으로 비워야 꺼진다
NAVER_SYNC_TIME=
AUTO_NAVER_DRAFT=false
AGENT_TOOL_LOOP=true
AGENT_SHELL=false

# ── 품질 게이트 — 기본값(on) 유지. 게이트 자체를 시험하지 않을 때 LLM 콜을 아끼려면 주석 해제
# FACT_GATE=off
# BLOG_STYLE_LINT=off
# META_SUMMARY_LINT=off

# ── 알림 — 끔(테스트 런이 실제 텔레그램 채팅방으로 가지 않도록)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT=0
NOTIFY_CONTENT_READY=0
NOTIFY_AUTO_CYCLE=0
META_AI_LABEL=1

# ── 접근 제어 — 로컬 테스트용 고정 토큰(API 호출 시 Authorization: Bearer test-token)
AUTH_TOKEN=test-token
